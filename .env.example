# Optional legacy import. Prefer each host's existing Models API Key editor.
# Copy this file to .env only to bootstrap existing accounts.
#
# Resolution follows the standard dotenv convention:
#   the process environment wins, then these files fill only unset keys:
#     ./.env  ->  ~/.zcode/.env  ->  ~/.env
#   $MISTRAL_BRIDGE_ENV replaces the file list with one explicit path.
# For an installed plugin, ~/.zcode/.env is the stable location.
#
# Each key becomes its own ZCode or DSH provider:
#   MISTRAL_API_KEY        -> provider "mistral-default"
#   MISTRAL_API_KEY_WORK   -> provider "mistral-work"
#   MISTRAL_API_KEY_<NAME> -> provider "mistral-<name>"
#
# Legacy ZCode imports use "env:<name>" references resolved by the proxy.
# Keys entered in the native Models editor are stored by ZCode itself.
# DSH imports legacy keys into its native credential service.
# DSH: set config.envFile in the profile patch to this file's absolute path.
# DSH owns a separate listener; configure its port through config.port.

MISTRAL_API_KEY=mstrl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Additional keys (optional). Uncomment and rename as needed.
# MISTRAL_API_KEY_WORK=mstrl_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# MISTRAL_API_KEY_PERSONAL=mstrl_zzzzzzzzzzzzzzzzzzzzzzzzzzzz

# Model IDs per key, comma separated. MISTRAL_MODELS is the fallback.
# MISTRAL_MODELS=zai-glm-latest
# MISTRAL_MODELS_WORK=mistral-large-latest,magistral-medium-latest

# Pin the proxy port. Without this the proxy remembers its last free port,
# starting at 8791 and skipping ports owned by other programs.
# MISTRAL_BRIDGE_PORT=8791
